<?xml version="1.0" encoding="utf-8"?>
<!--
  Base theme. §4.13: confirm what the base theme inherits from before using any
  Material widget — Morsecode inherits from AppCompat (no Material Components
  dependency at all, §1.5/§3.3), so only AppCompat widgets are used and the
  0 dp switch bug cannot occur.

  Accent theme overlays for the five §4.4 swatches are added in Stage 2; the
  default accent is Sunflower.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Morsecode" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Sunflower design tokens (§4.2–4.4). -->
        <item name="colorBgBase">@color/bg_base</item>
        <item name="colorSurfaceCard">@color/surface_card</item>
        <item name="colorSurfaceRaised">@color/surface_raised</item>
        <item name="colorSurfacePressed">@color/surface_pressed</item>
        <item name="colorHairline">@color/hairline_divider</item>
        <item name="colorTextPrimary">@color/text_primary</item>
        <item name="colorTextSecondary">@color/text_secondary</item>
        <item name="colorTextMeta">@color/text_meta</item>
        <item name="colorScrimOverlay">@color/scrim_overlay</item>

        <item name="colorAccentMain">@color/accent_sunflower</item>
        <item name="colorAccentPressed">@color/accent_sunflower_pressed</item>
        <item name="colorAccentDeep">@color/accent_sunflower_deep</item>
        <item name="colorInkOnAccent">@color/ink_on_accent</item>

        <!-- Light-mode cards carry a 1 dp border AND a 2 dp/4% soft shadow (§4.3). -->
        <item name="isLightSurface">true</item>
        <item name="colorViewerBackdrop">@color/viewer_backdrop_light</item>
        <item name="colorViewerChrome">@color/viewer_chrome</item>
        <item name="colorViewerChromeScrim">@color/viewer_chrome_scrim</item>
        <item name="cardElevation">@dimen/card_elevation_light</item>

        <!-- AppCompat plumbing mapped onto the same tokens. -->
        <item name="colorPrimary">@color/accent_sunflower</item>
        <item name="colorPrimaryDark">@color/bg_base</item>
        <item name="colorAccent">@color/accent_sunflower</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg_base</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/bg_base</item>
    </style>

    <!--
      §4.8 dialog radius 20 dp; §4.2/§4.3 scrim (62% black in dark, 38% ink in
      light, applied by the platform dim). Floating window so the consent card
      sits centred over a dimmed screen (§6.16).
    -->
    <style name="Theme.Morsecode.Dialog" parent="Theme.Morsecode">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- §4.11: sheets spring in over 220 ms. -->
    <style name="Animation.Morsecode.BottomSheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
</resources>
