    <!-- ===== Help (§6.17) ===== -->
    <string name="help_empty">Help articles arrive with the screens they explain</string>
    <string name="help_q1">How does Morsecode work?</string>
    <string name="help_a1">Two phones on the same Wi-Fi connect directly. If there\'s no shared network, Nearby Connections uses Bluetooth or Wi-Fi Direct.</string>
    <string name="help_q2">Do I need internet?</string>
    <string name="help_a2">No. Everything happens on your local network, and nothing is uploaded anywhere.</string>
    <string name="help_q3">Can I send and receive at the same time?</string>
    <string name="help_a3">Yes. A session carries both directions at once, and the transfer screen shows a Sending and a Receiving section.</string>
    <string name="help_q4">What is WebShare?</string>
    <string name="help_a4">A small web server on your phone. Any browser on the same network can browse, download and upload once you accept it.</string>
    <string name="help_q5">Where are my logs?</string>
    <string name="help_a5">Settings → Logs. Export .txt hands the whole log to any app you choose.</string>
