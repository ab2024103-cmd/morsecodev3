<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ equivalent of backup_rules.xml (§16.6, §17.1). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="logs" />
        <exclude
            domain="file"
            path="crash" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="logs" />
        <exclude
            domain="file"
            path="crash" />
    </device-transfer>
</data-extraction-rules>
